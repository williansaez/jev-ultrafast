TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
# Default: local Ollama (free, page text stays on this machine). Run `ollama pull qwen3.5:9b` first.
TEXT_MODEL_API_KEY=ollama
TEXT_MODEL_BASE_URL=http://127.0.0.1:11434/v1
TEXT_MODEL=qwen3.5:9b
TEXT_MODEL_REASONING=effort_none
# Original upstream setup (OpenRouter, paid):
# TEXT_MODEL_API_KEY=
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEXT_MODEL=inception/mercury-2.5
# TEXT_MODEL_REASONING=none
# Dedicated browser with CDP; the MCP server starts it when the port does not answer (macOS).
BU_CDP_URL=http://127.0.0.1:9222
# JEV_EDGE_PROFILE_DIR=~/.config/browser-harness/edge-profile
# JEV_BROWSER_APP="Microsoft Edge"
